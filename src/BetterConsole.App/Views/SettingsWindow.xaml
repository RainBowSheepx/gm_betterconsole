<Window x:Class="BetterConsole.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — BetterConsole" Width="780" Height="720" MinWidth="620" MinHeight="480"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="Margin" Value="0,18,0,10" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,6,24,10">
            <StackPanel>
                <Border x:Name="Welcome" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Large}" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Welcome to BetterConsole" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Pick the folder of your Garry's Mod dedicated server (the one with srcds.exe) and its start options. Have a start.bat? Import it — the options are copied from it." />
                    </StackPanel>
                </Border>

                <!-- ====================================================== server -->
                <TextBlock Text="Server" Style="{StaticResource Section}" />
                <TextBlock Text="Server folder (contains srcds.exe and the garrysmod folder)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
                    <TextBox x:Name="ServerDir" TextChanged="OnServerDirChanged" />
                </DockPanel>
                <TextBlock x:Name="ServerDirInfo" Style="{StaticResource Help}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Executable" Style="{StaticResource Label}" />
                        <ComboBox x:Name="Exe" />
                        <TextBlock Style="{StaticResource Help}" Text="srcds.exe and srcds_win64.exe open their own console window, so their srcds_console twins are started instead. Auto prefers 64-bit." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="&#160;" Style="{StaticResource Label}" />
                        <Button Content="Import from start.bat…" Click="OnImportBat" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Start options" Style="{StaticResource Label}" />
                <TextBox x:Name="Args" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="58"
                         VerticalContentAlignment="Top" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Add:" Style="{StaticResource Help}" Margin="0,4,8,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+map" Tag="+map gm_construct" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+maxplayers" Tag="+maxplayers 16" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+gamemode" Tag="+gamemode sandbox" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="-tickrate" Tag="-tickrate 33" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="-port" Tag="-port 27015" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+host_workshop_collection" Tag="+host_workshop_collection 0" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+sv_setsteamaccount" Tag="+sv_setsteamaccount TOKEN" Click="OnAddArg" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Help}" Text="-console is added automatically. Leave out -condebug: BetterConsole keeps the log itself (Console → Save)." />

                <CheckBox x:Name="AutoRestart" Content="Restart the server when it crashes" />
                <StackPanel Orientation="Horizontal" Margin="26,0,0,8">
                    <TextBlock Text="after" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="RestartDelay" Width="60" />
                    <TextBlock Text="seconds (stops after 5 crashes in 10 minutes)" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="InstallCompanion" Content="Install the companion addon and module into the server before each start (recommended)" />
                <TextBlock Style="{StaticResource Help}" Margin="26,0,0,10"
                           Text="Copies garrysmod/addons/betterconsole and garrysmod/lua/bin/gmsv_betterconsole_win32/64.dll. Without them there are no structured Lua errors, statistics, players, auto-completion or addon tabs. They stay idle when the server is started without BetterConsole." />
                <CheckBox x:Name="StartWithApp" Content="Start the server when BetterConsole opens" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Wait for &quot;quit&quot;" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="StopTimeout" Width="60" />
                    <TextBlock Text="seconds before killing the process" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- ====================================================== console -->
                <TextBlock Text="Console" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Font" Style="{StaticResource Label}" />
                        <ComboBox x:Name="Font" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                        <ComboBox x:Name="FontSize2" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Lines kept" Style="{StaticResource Label}" />
                        <TextBox x:Name="MaxLines" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="HideErrors" Content="Keep Lua errors out of the console (they have their own tabs)" Margin="0,12,0,8" />
                <CheckBox x:Name="ServerOnly" Content="Auto-complete server commands only (hide client commands like bind, cl_*, mat_*)" />
                <CheckBox x:Name="ConfirmExit" Content="Ask before closing while the server runs" />

                <!-- ====================================================== errors -->
                <TextBlock Text="Lua errors" Style="{StaticResource Section}" />
                <CheckBox x:Name="MergeSimilar" Content="Count errors that differ only in entity numbers or table addresses as one" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Keep up to" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="MaxErrors" Width="70" />
                    <TextBlock Text="distinct errors per list" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>

                <!-- ====================================================== appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                <TextBlock Text="Theme" Style="{StaticResource Label}" />
                <ComboBox x:Name="Theme" Width="240" HorizontalAlignment="Left" SelectionChanged="OnThemePreview" />
                <TextBlock Style="{StaticResource Help}" Text="Your own themes: JSON files in the themes folder next to BetterConsole.exe (see docs/themes.md)." />

                <!-- ====================================================== plugins -->
                <TextBlock Text="Plugins" Style="{StaticResource Section}" />
                <TextBlock x:Name="PluginsInfo" Style="{StaticResource Help}" Margin="0,0,0,8" />
                <ItemsControl x:Name="PluginList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" Content="Enabled" VerticalAlignment="Center" Margin="0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Help}" Text="Plugin changes apply after BetterConsole restarts. How to write one: docs/plugins.md." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <TextBlock x:Name="DataDir" Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="Save" MinWidth="90" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="OnSave" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
