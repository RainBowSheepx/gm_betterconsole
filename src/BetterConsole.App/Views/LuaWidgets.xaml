<!-- How the widgets of addons look: on their own tabs (BetterConsole.AddTab) and on the Statistics tab (BetterConsole.Stats). -->
<ResourceDictionary x:Class="BetterConsole.App.Views.LuaWidgets"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:BetterConsole.App.ViewModels"
                    xmlns:c="clr-namespace:BetterConsole.App.Controls">

    <Style x:Key="WidgetCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,12,12" />
    </Style>

    <!-- a key number: the built-in ones of the Statistics tab and Stat widgets -->
    <Style x:Key="Kpi" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Kpi}" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.KpiWidth}" />
    </Style>
    <Style x:Key="KpiLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Section}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="KpiValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.KpiSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    </Style>
    <Style x:Key="KpiSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <DataTemplate DataType="{x:Type vm:StatWidgetVm}">
        <Border Style="{StaticResource Kpi}" ToolTip="{Binding Tooltip}">
            <StackPanel>
                <TextBlock Text="{Binding Label}" Style="{StaticResource KpiLabel}" />
                <TextBlock x:Name="V" Text="{Binding Value}" Style="{StaticResource KpiValue}" />
                <TextBlock Text="{Binding Sub}" Style="{StaticResource KpiSub}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding ValueBrush, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                <Setter TargetName="V" Property="Foreground" Value="{Binding ValueBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TextWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,6" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:KeyValueWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" SharedSizeGroup="k" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TableWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <DataGrid ItemsSource="{Binding Rows}" MaxHeight="420" Loaded="OnTableLoaded" RowHeight="{DynamicResource Size.Row}" FontSize="12.5"
                          VirtualizingPanel.IsVirtualizing="True" c:ScrollChain.IsEnabled="True" />
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LogWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <Border Background="{DynamicResource Brush.ConsoleBackground}" CornerRadius="{DynamicResource Radius}" Padding="8,6" Height="260">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" c:ScrollAnchor.IsEnabled="True" c:ScrollAnchor.StickToBottom="True">
                        <ItemsControl ItemsSource="{Binding Lines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid c:ScrollAnchor.IsCandidate="True">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,10,0" />
                                        <TextBox x:Name="T" Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5"
                                                 Foreground="{DynamicResource Brush.ConsoleText}" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Color, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                            <Setter TargetName="T" Property="Foreground" Value="{Binding Color}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ChartWidgetVm}">
        <Border Style="{StaticResource WidgetCard}" Height="230">
            <c:TimeSeriesChart Title="{Binding Title}" Unit="{Binding Unit}" Loaded="OnChartLoaded" WindowSeconds="600" Decimals="1" />
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ButtonsWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Text}" Margin="0,0,8,8" Click="OnButtonClick" Loaded="OnButtonLoaded" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- settings: a row per field (Controls/FormView.cs) -->
    <DataTemplate DataType="{x:Type vm:FormWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,10" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <c:FormView />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- a plugin's section on the Statistics tab -->
    <DataTemplate DataType="{x:Type vm:SectionWidgetVm}">
        <Border Style="{StaticResource WidgetCard}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource Text.Title}" Margin="0,0,0,8" Visibility="{Binding Title, Converter={StaticResource NullToCollapsed}}" />
                <ContentPresenter Content="{Binding Content}" />
            </DockPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
