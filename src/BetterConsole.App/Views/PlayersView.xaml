<UserControl x:Class="BetterConsole.App.Views.PlayersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="2,0,0,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Border x:Name="UlxPill" Style="{StaticResource Pill}" Margin="0,0,8,0" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="UlxText" FontSize="11.5" />
                </Border>
                <Button x:Name="SelectAllButton" Style="{StaticResource Btn.Ghost}" Click="OnSelectAll" Margin="0,0,6,0"
                        ToolTip="Select every player (also Ctrl+A, Ctrl+click, Shift+click); right-click the selection for actions on all of them">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="13" />
                        <TextBlock x:Name="SelectAllLabel" Text="Select all" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Ghost}" Click="OnColumnsClick" ToolTip="Choose the columns (also: right-click a column header)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="13" />
                        <TextBlock Text="Columns" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Players" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                <Border Style="{StaticResource Pill}" Margin="10,0,0,0" Background="{DynamicResource Brush.AccentSoft}" Padding="9,2">
                    <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" />
                </Border>
                <TextBlock x:Name="SelectionText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                <TextBlock x:Name="Hint" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" FontSize="12" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Large}" Padding="6,4">
            <Grid>
                <DataGrid x:Name="Grid" Sorting="OnSorting" MouseRightButtonUp="OnRowRightClick" SelectionChanged="OnSelectionChanged" SelectionMode="Extended" CanUserReorderColumns="True" CanUserSortColumns="True"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nick" SortMemberPath="Name" Width="2*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Steam avatar over the coloured initial (shown while there is no avatar, or for bots) -->
                                        <Grid Width="22" Height="22" Margin="0,0,8,0" Visibility="{DynamicResource Visibility.NotCompact}">
                                            <Border CornerRadius="11" Background="{Binding Name, Converter={StaticResource NameToColor}}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsBot, Converter={StaticResource BoolToCollapsed}}" />
                                                    <TextBlock Text="&#xE99A;" FontFamily="{StaticResource Font.Icons}" Foreground="#FFFFFF" FontSize="12"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding IsBot, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Border>
                                            <Ellipse Visibility="{Binding Avatar, Converter={StaticResource NullToCollapsed}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="  BOT" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}"
                                                   Visibility="{Binding IsBot, Converter={StaticResource BoolToVisibility}}" />
                                        <!-- gagged / muted / jailed: small chips with some room after the name and between them -->
                                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="{DynamicResource Brush.WarningSoft}" SnapsToDevicePixels="True"
                                                    ToolTip="Gagged (voice)" Visibility="{Binding Gagged, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="&#xE74F;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                                                           TextOptions.TextRenderingMode="Grayscale" />
                                            </Border>
                                            <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="{DynamicResource Brush.WarningSoft}" SnapsToDevicePixels="True"
                                                    ToolTip="Muted (chat)" Visibility="{Binding Muted, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="&#xE8BD;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Warning}"
                                                           TextOptions.TextRenderingMode="Grayscale" />
                                            </Border>
                                            <Border CornerRadius="4" Padding="5,2" Margin="0,0,4,0" Background="{DynamicResource Brush.DangerSoft}" SnapsToDevicePixels="True"
                                                    ToolTip="Jailed" Visibility="{Binding Jailed, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Foreground="{DynamicResource Brush.Danger}"
                                                           TextOptions.TextRenderingMode="Grayscale" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SteamID" Binding="{Binding SteamId}" SortMemberPath="SteamId" Width="1.4*" MinWidth="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Group" SortMemberPath="GroupRank" Width="Auto" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Group}" FontSize="11.5" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Load ms" SortMemberPath="Load" Width="Auto" MinWidth="80">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Server CPU spent on the player per tick: processing their commands and net messages. Measured while this tab is open." />
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="T" Text="{Binding LoadText}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding LoadLevel}" Value="1">
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LoadLevel}" Value="2">
                                            <Setter TargetName="T" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                            <Setter TargetName="T" Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Loss" Binding="{Binding LossText}" SortMemberPath="Loss" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="Ping" Binding="{Binding PingText}" SortMemberPath="Ping" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="FPS" Binding="{Binding FpsText}" SortMemberPath="Fps" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="TimeConnected" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="IP" Binding="{Binding Ip}" SortMemberPath="Ip" Width="Auto" MinWidth="110" />
                        <DataGridTextColumn Header="In" Binding="{Binding InText}" SortMemberPath="InBytes" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="Out" Binding="{Binding OutText}" SortMemberPath="OutBytes" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="Choke" Binding="{Binding ChokeText}" SortMemberPath="Choke" Width="Auto" MinWidth="60" />
                        <DataGridTextColumn Header="Team" Binding="{Binding Team}" SortMemberPath="Team" Width="Auto" MinWidth="80" />
                        <DataGridTextColumn Header="Score" Binding="{Binding Frags}" SortMemberPath="Frags" Width="Auto" MinWidth="55" />
                        <DataGridTextColumn Header="cl_updaterate" Binding="{Binding UpdateRateText}" SortMemberPath="UpdateRate" Width="Auto" MinWidth="70">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Snapshots per second the client asks the server for. The server keeps it between sv_minupdaterate and sv_maxupdaterate and never above its tick rate." />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="cl_cmdrate" Binding="{Binding CmdRateText}" SortMemberPath="CmdRate" Width="Auto" MinWidth="70">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="ToolTip" Value="Command packets per second the client wants to send. The server keeps it between sv_mincmdrate and sv_maxcmdrate." />
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="Empty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="&#xE716;" FontFamily="{StaticResource Font.Icons}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock x:Name="EmptyTitle" Text="Nobody is playing" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock x:Name="EmptyText" Text="Players appear here as they join. Right-click a player for admin actions." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
