<UserControl x:Class="BetterConsole.App.Views.ClientErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BetterConsole.App.Controls"
             xmlns:vm="clr-namespace:BetterConsole.App.ViewModels">
    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource Btn.Ghost}" Click="OnCollapseAll">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A0;" FontSize="13" />
                        <TextBlock Text="Collapse all" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Ghost}" Click="OnCopyAll">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="13" />
                        <TextBlock Text="Copy all" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Ghost}" Click="OnClear">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Clear" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid Width="280" HorizontalAlignment="Left">
                <TextBox x:Name="Filter" TextChanged="OnFilterChanged" Padding="30,7,8,7" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" HorizontalAlignment="Left" Margin="10,0,0,0"
                           Foreground="{DynamicResource Brush.TextMuted}" IsHitTestVisible="False" />
                <TextBlock Text="Filter by player or error…" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding Text, ElementName=Filter, Converter={StaticResource NullToVisible}}" />
            </Grid>
            <TextBlock x:Name="Summary" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Muted}" FontSize="12" />
        </DockPanel>

        <Border x:Name="FrozenBar" Grid.Row="1" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius}" Padding="10,5" Margin="0,0,0,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Brush.Text}" FontSize="12"
                           Text="Order paused while the pointer is over the list — counters still update, cards move when you leave." />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      c:ScrollAnchor.IsEnabled="True" Padding="0,0,4,0" MouseEnter="OnPointerEnter" MouseLeave="OnPointerLeave">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlayerErrorsVm}">
                        <StackPanel Margin="0,0,0,6">
                            <!-- player header -->
                            <Border x:Name="Header" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius}" Padding="10,8" Cursor="Hand" c:ScrollAnchor.IsCandidate="True"
                                    MouseLeftButtonUp="OnHeaderClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Chevron" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" />
                                    <Grid Grid.Column="1" Width="28" Height="28" Margin="0,0,10,0">
                                        <Border CornerRadius="14" Background="{Binding Name, Converter={StaticResource NameToColor}}">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initial}}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Ellipse Visibility="{Binding Avatar, Converter={StaticResource NullToCollapsed}}">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Style="{StaticResource SelectableText}" Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5" TextWrapping="NoWrap" />
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Danger}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                     Visibility="{Binding HasUnseen, Converter={StaticResource BoolToVisibility}}" ToolTip="New errors since you last opened this player" />
                                        </StackPanel>
                                        <TextBox Style="{StaticResource SelectableText}" Text="{Binding SteamId, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5"
                                                 Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="NoWrap" HorizontalAlignment="Left" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastSeenText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="Last error" />
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.DangerSoft}" ToolTip="Distinct errors / all errors">
                                            <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}">
                                                <Run Text="{Binding UniqueCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding TotalCount, Mode=OneWay}" />
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- errors of the player, newest first -->
                            <ItemsControl x:Name="Entries" ItemsSource="{Binding Entries}" Margin="22,6,0,0" Visibility="Collapsed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <c:ErrorCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="Entries" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            </DataTrigger>
                            <Trigger SourceName="Header" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Header" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Success}" />
            <TextBlock Text="No client Lua errors" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="Errors players' games send to the server appear here, grouped by player." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
