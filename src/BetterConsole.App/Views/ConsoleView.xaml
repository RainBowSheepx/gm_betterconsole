<UserControl x:Class="BetterConsole.App.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vm="clr-namespace:BetterConsole.App.ViewModels">
    <Grid Margin="12,8,12,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <DockPanel Margin="0,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock x:Name="LineCount" Style="{StaticResource Text.Muted}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Style="{StaticResource Btn.Ghost}" ToolTip="Find (Ctrl+F)" Click="OnFind">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="13" />
                        <TextBlock Text="Find" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="WrapToggle" Style="{StaticResource Toggle.Ghost}" ToolTip="Wrap long lines" Checked="OnWrapChanged" Unchecked="OnWrapChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE751;" FontSize="13" />
                        <TextBlock Text="Wrap" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="TimeToggle" Style="{StaticResource Toggle.Ghost}" ToolTip="Show the time of every line" Checked="OnTimeChanged" Unchecked="OnTimeChanged">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE823;" FontSize="13" />
                        <TextBlock Text="Time" Margin="6,0,0,0" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource Btn.Ghost}" ToolTip="Save the console to a text file" Click="OnSave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="13" />
                        <TextBlock Text="Save" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Ghost}" ToolTip="Clear the console tab (the server is not affected)" Click="OnClear">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                        <TextBlock Text="Clear" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- output -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.ConsoleBackground}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Large}" ClipToBounds="True">
            <Grid>
                <ae:TextEditor x:Name="Output" IsReadOnly="True" ShowLineNumbers="False" Padding="10,8,4,8"
                               Background="Transparent" Foreground="{DynamicResource Brush.ConsoleText}"
                               FontSize="13" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               WordWrap="False">
                    <ae:TextEditor.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
                            <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
                            <Separator />
                            <MenuItem Header="Find…" Click="OnFind" InputGestureText="Ctrl+F" />
                            <MenuItem Header="Save to file…" Click="OnSave" />
                            <MenuItem Header="Clear console" Click="OnClear" />
                        </ContextMenu>
                    </ae:TextEditor.ContextMenu>
                </ae:TextEditor>

                <!-- appears when scrolled up: back to the live end -->
                <Button x:Name="JumpButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,14" Visibility="Collapsed"
                        Style="{StaticResource Btn.Primary}" Padding="12,6" Click="OnJumpToEnd" ToolTip="Scroll to the newest line and follow the output">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
                    </Button.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74B;" FontSize="12" Foreground="{DynamicResource Brush.OnAccent}" />
                        <TextBlock x:Name="JumpText" Text="Follow" Margin="7,0,0,0" Foreground="{DynamicResource Brush.OnAccent}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- input: its own container, never covered by output -->
        <Border Grid.Row="2" Margin="0,8,0,0" Background="{DynamicResource Brush.InputBackground}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Large}" x:Name="InputBorder">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource Font.Icons}" FontSize="12" Margin="12,0,4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Accent}" />
                <TextBox x:Name="Input" Grid.Column="1" BorderThickness="0" Background="Transparent" FontFamily="{StaticResource Font.Mono}" FontSize="13.5"
                         Padding="6,8" PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputChanged" LostKeyboardFocus="OnInputLostFocus"
                         AcceptsReturn="False" AcceptsTab="False" />
                <TextBlock x:Name="Placeholder" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                           FontFamily="{StaticResource Font.Mono}" FontSize="13.5" Foreground="{DynamicResource Brush.TextMuted}"
                           Text="Type a command…  (Tab completes, ↑/↓ history, Ctrl+F find)" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Margin="0,0,6,0" Click="OnSendClick" ToolTip="Run (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" FontSize="13" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock Text="Run" Margin="6,0,0,0" />
                    </StackPanel>
                </Button>

                <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=InputBorder}" Placement="Bottom" VerticalOffset="4"
                       AllowsTransparency="True" StaysOpen="True" Focusable="False" PopupAnimation="None">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius}" Padding="4" Margin="0,0,10,10"
                            Width="{Binding ActualWidth, ElementName=InputBorder}" MaxWidth="900" HorizontalAlignment="Left">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" />
                        </Border.Effect>
                        <DockPanel>
                            <TextBlock x:Name="SuggestFooter" DockPanel.Dock="Bottom" Margin="8,4,8,2" FontSize="11" Style="{StaticResource Text.Muted}" />
                            <ListBox x:Name="Suggestions" MaxHeight="330" BorderThickness="0" Background="Transparent" Focusable="False"
                                     ItemContainerStyle="{StaticResource PlainListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" PreviewMouseLeftButtonUp="OnSuggestionClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:CompletionItem}">
                                        <Grid ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="600">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="220" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontFamily="{StaticResource Font.Mono}" FontSize="13" VerticalAlignment="Center">
                                                <Run Text="{Binding Before, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" /><Run Text="{Binding Match, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" /><Run Text="{Binding After, Mode=OneWay}" Foreground="{DynamicResource Brush.Text}" />
                                            </TextBlock>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" Foreground="{DynamicResource Brush.Warning}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,0,12,0" />
                                                <TextBlock Text="{Binding HelpLine}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Pill}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding KindText}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</UserControl>
