<Window x:Class="BetterConsole.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings — BetterConsole" Width="800" Height="760" MinWidth="640" MinHeight="480"
        Background="{DynamicResource Brush.Panel}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="Margin" Value="0,18,0,10" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,12" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="24,6,24,10">
            <StackPanel>
                <Border x:Name="Welcome" Background="{DynamicResource Brush.AccentSoft}" CornerRadius="{StaticResource Radius.Large}" Padding="14,12" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Welcome to BetterConsole" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="Pick the folder of your Garry's Mod dedicated server (the one with srcds.exe) and its start options. Have a start.bat? Import it — the options are copied from it. Running several servers? Switch on multi-console below and add the others." />
                    </StackPanel>
                </Border>

                <!-- ====================================================== servers (multi-console) -->
                <TextBlock Text="Servers" Style="{StaticResource Section}" />
                <CheckBox x:Name="Multi" Content="Multi-console: run and watch several servers from one BetterConsole" Checked="OnMultiChanged" Unchecked="OnMultiChanged" />
                <TextBlock Style="{StaticResource Help}" Margin="26,-4,0,10"
                           Text="The logo in the top left corner opens the list of servers (with their state, map, players and server fps). A server can get a window of its own and come back. Settings are shared, only the server options below are per server." />
                <Grid x:Name="ServersPanel" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{StaticResource Radius}" Padding="4">
                        <ListBox x:Name="ServerList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource PlainListBoxItem}"
                                 MaxHeight="190" SelectionChanged="OnServerSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <Button Click="OnAddServer" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add server" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="RemoveServer" Click="OnRemoveServer" Margin="0,0,0,6" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Foreground="{DynamicResource Brush.Danger}" />
                                <TextBlock Text="Remove" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.Icon}" Content="&#xE70E;" ToolTip="Move up" Click="OnMoveUp" />
                            <Button Style="{StaticResource Btn.Icon}" Content="&#xE70D;" ToolTip="Move down" Click="OnMoveDown" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ====================================================== server -->
                <TextBlock x:Name="ServerHeading" Text="Server" Style="{StaticResource Section}" />
                <StackPanel x:Name="NamePanel">
                    <TextBlock Text="Name in the server list (empty: the hostname of the server)" Style="{StaticResource Label}" />
                    <TextBox x:Name="ServerName" Margin="0,0,0,12" TextChanged="OnServerNameChanged" />
                </StackPanel>
                <TextBlock Text="Server folder (contains srcds.exe and the garrysmod folder)" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
                    <TextBox x:Name="ServerDir" TextChanged="OnServerDirChanged" />
                </DockPanel>
                <TextBlock x:Name="ServerDirInfo" Style="{StaticResource Help}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Executable" Style="{StaticResource Label}" />
                        <ComboBox x:Name="Exe" />
                        <TextBlock Style="{StaticResource Help}" Text="srcds.exe and srcds_win64.exe open their own console window, so their srcds_console twins are started instead. Auto prefers 64-bit." />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                        <TextBlock Text="&#160;" Style="{StaticResource Label}" />
                        <Button Content="Import from start.bat…" Click="OnImportBat" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Start options" Style="{StaticResource Label}" />
                <TextBox x:Name="Args" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="58"
                         VerticalContentAlignment="Top" />
                <WrapPanel Margin="0,6,0,0">
                    <TextBlock Text="Add:" Style="{StaticResource Help}" Margin="0,4,8,0" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+map" Tag="+map gm_construct" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+maxplayers" Tag="+maxplayers 16" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+gamemode" Tag="+gamemode sandbox" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="-tickrate" Tag="-tickrate 33" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="-port" Tag="-port 27015" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+host_workshop_collection" Tag="+host_workshop_collection 0" Click="OnAddArg" />
                    <Button Style="{StaticResource Btn.Ghost}" Content="+sv_setsteamaccount" Tag="+sv_setsteamaccount TOKEN" Click="OnAddArg" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Help}" Text="-console is added automatically. Leave out -condebug: BetterConsole keeps the log itself (Console → Save). Several servers need different -port values." />

                <CheckBox x:Name="AlwaysRun" Content="Always run" Checked="OnAlwaysRunChanged" Unchecked="OnAlwaysRunChanged" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Help}" Margin="26,-4,0,10"
                           Text="Starts the server again whatever stopped it: a crash, a quit from the game, rcon or an addon, &quot;quit&quot; typed in the console. Keeps trying after many crashes (waiting longer each time) and starts it with BetterConsole. Only Stop, Kill and closing BetterConsole leave it off." />
                <CheckBox x:Name="AutoRestart" Content="Restart the server when it crashes or quits by itself" />
                <StackPanel Orientation="Horizontal" Margin="26,0,0,8">
                    <TextBlock Text="after" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="RestartDelay" Width="60" />
                    <TextBlock Text="seconds (stops after 5 crashes in 10 minutes)" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>
                <CheckBox x:Name="InstallCompanion" Content="Install the companion addon and module into the server before each start (recommended)" />
                <TextBlock Style="{StaticResource Help}" Margin="26,0,0,10"
                           Text="Copies garrysmod/addons/betterconsole and garrysmod/lua/bin/gmsv_betterconsole_win32/64.dll. Without them there are no structured Lua errors, statistics, players, auto-completion or addon tabs. They stay idle when the server is started without BetterConsole." />
                <CheckBox x:Name="StartWithApp" Content="Start the server when BetterConsole opens" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Wait for &quot;quit&quot;" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="StopTimeout" Width="60" />
                    <TextBlock Text="seconds before killing the process" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Processors and priority" Style="{StaticResource Label}" Margin="0,16,0,5" />
                <DockPanel>
                    <Button DockPanel.Dock="Left" Content="Choose…" Click="OnAffinity" Margin="0,0,10,0" />
                    <TextBlock x:Name="AffinityText" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Help}" Text="Which CPUs srcds may run on (default: all of them) and the priority of its process. Also in the … menu of the window, applied at once there." />

                <TextBlock Text="Scheduled restarts" Style="{StaticResource Label}" Margin="0,6,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="RestartTimes" FontFamily="{StaticResource Font.Mono}" TextChanged="OnRestartTimesChanged" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,3,0,8" Text="Every day at these times, e.g. 05:00, 17:30. Empty: never." />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="WarnMinutes" FontFamily="{StaticResource Font.Mono}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,3,0,8" Text="warn players this many minutes before (e.g. 5, 1)" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Warning in the chat ({time} becomes &quot;5 minutes&quot;)" Style="{StaticResource Label}" />
                <TextBox x:Name="WarnText" />
                <TextBlock x:Name="ScheduleInfo" Style="{StaticResource Help}" Text="Said with the say command. The restart is written to the start / stop journal (… menu)." />

                <!-- ====================================================== console -->
                <TextBlock Text="Console" Style="{StaticResource Section}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Font" Style="{StaticResource Label}" />
                        <ComboBox x:Name="Font" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Size" Style="{StaticResource Label}" />
                        <ComboBox x:Name="FontSize2" IsEditable="True" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Lines kept" Style="{StaticResource Label}" />
                        <TextBox x:Name="MaxLines" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="HideErrors" Content="Keep Lua errors out of the console (they have their own tabs)" Margin="0,12,0,8" />
                <CheckBox x:Name="ServerOnly" Content="Auto-complete server commands only (hide client commands like bind, cl_*, mat_*)" />
                <CheckBox x:Name="ConfirmExit" Content="Ask before closing while a server runs" />

                <!-- ====================================================== errors -->
                <TextBlock Text="Lua errors and files" Style="{StaticResource Section}" />
                <CheckBox x:Name="MergeSimilar" Content="Count errors that differ only in entity numbers or table addresses as one" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                    <TextBlock Text="Keep up to" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="0,0,8,0" />
                    <TextBox x:Name="MaxErrors" Width="70" />
                    <TextBlock Text="distinct errors per list" VerticalAlignment="Center" Style="{StaticResource Label}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Open Lua files with" Style="{StaticResource Label}" />
                <ComboBox x:Name="Editor" Width="360" HorizontalAlignment="Left" SelectionChanged="OnEditorChanged" />
                <StackPanel x:Name="CustomEditorPanel" Margin="0,8,0,0">
                    <TextBlock Text="Command ({file} and {line} are replaced)" Style="{StaticResource Label}" />
                    <TextBox x:Name="EditorCommand" FontFamily="{StaticResource Font.Mono}" FontSize="12.5" />
                </StackPanel>
                <TextBlock Style="{StaticResource Help}" Text="Double-click a path in a Lua error, its stack trace, or a hook, timer or net message of the profiler: the file opens at its line. Works for files on the server's disk (folder addons, lua/, gamemodes/), not for those packed in workshop .gma files." />

                <!-- ====================================================== players -->
                <TextBlock Text="Players" Style="{StaticResource Section}" />
                <CheckBox x:Name="ShowAvatars" Content="Show Steam avatars (players, client errors, admin dialogs)" />
                <TextBlock Style="{StaticResource Help}" Margin="26,-4,0,10" Text="Downloaded from the players' public Steam profiles (steamcommunity.com) and kept in cache\avatars for a few days. Without them, or when Steam cannot be reached, the coloured initial is shown." />

                <!-- ====================================================== appearance -->
                <TextBlock Text="Appearance" Style="{StaticResource Section}" />
                <TextBlock Text="Theme" Style="{StaticResource Label}" />
                <ComboBox x:Name="Theme" Width="240" HorizontalAlignment="Left" SelectionChanged="OnThemePreview" />
                <TextBlock Style="{StaticResource Help}" Text="Your own themes: JSON files in the themes folder next to BetterConsole.exe (see docs/themes.md)." />
                <TextBlock Text="Tab titles" Style="{StaticResource Label}" />
                <ComboBox x:Name="TabTitles" Width="360" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Show icon and title" Tag="show" />
                    <ComboBoxItem Content="Icons only" Tag="icons" />
                    <ComboBoxItem Content="Icons only when the titles do not fit" Tag="auto" />
                </ComboBox>
                <TextBlock Style="{StaticResource Help}" Text="With icons only the title is in the tooltip. Also on the right-click menu of the tab bar." />

                <!-- ====================================================== plugins -->
                <TextBlock Text="Plugins" Style="{StaticResource Section}" />
                <TextBlock x:Name="PluginsInfo" Style="{StaticResource Help}" Margin="0,0,0,8" />
                <ItemsControl x:Name="PluginList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,6">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}" Content="Enabled" VerticalAlignment="Center" Margin="0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Muted}" FontSize="11" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Help}" Text="Plugin changes apply after BetterConsole restarts. With several servers each server has its own instance of a plugin. How to write one: docs/plugins.md." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Brush.Background}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="12,0,0,0">
                    <Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="Save" MinWidth="90" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="OnSave" />
                </StackPanel>
                <TextBlock x:Name="DataDir" Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
