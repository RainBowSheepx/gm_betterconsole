<UserControl x:Class="BetterConsole.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BetterConsole.App.Controls"
             xmlns:vm="clr-namespace:BetterConsole.App.ViewModels"
             xmlns:v="clr-namespace:BetterConsole.App.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- the widgets of addons, and the look of the key numbers (Kpi…) -->
                <v:LuaWidgets />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChartCard" TargetType="Border" BasedOn="{StaticResource Card}">
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="12,10,12,8" />
                <Setter Property="Height" Value="{DynamicResource Size.Chart}" />
            </Style>
            <Style x:Key="ProfGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="RowHeight" Value="26" />
                <Setter Property="MaxHeight" Value="330" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CanUserSortColumns" Value="True" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="c:ScrollChain.IsEnabled" Value="True" />
                <!-- double-click a path: the file opens in the editor -->
                <Setter Property="c:LuaLinks.IsEnabled" Value="True" />
            </Style>
            <!-- the name of a hook / timer / net message: where its function is (tooltip, double-click opens it) -->
            <Style x:Key="DefinedInCell" TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                <Setter Property="Tag" Value="{Binding Source}" />
                <Setter Property="ToolTip" Value="{Binding SourceTip}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{DynamicResource Pad.PageScroll}">
        <StackPanel x:Name="Root">
            <!-- toolbar -->
            <DockPanel Margin="0,0,10,10">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock Text="Window" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton x:Name="W1" Content="1 min" Style="{StaticResource Toggle.Ghost}" Click="OnWindow" Tag="1" />
                    <ToggleButton x:Name="W5" Content="5 min" Style="{StaticResource Toggle.Ghost}" Click="OnWindow" Tag="5" />
                    <ToggleButton x:Name="W15" Content="15 min" Style="{StaticResource Toggle.Ghost}" Click="OnWindow" Tag="15" />
                    <ToggleButton x:Name="W60" Content="1 hour" Style="{StaticResource Toggle.Ghost}" Click="OnWindow" Tag="60" />
                </StackPanel>
                <TextBlock x:Name="Note" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
            </DockPanel>

            <!-- key numbers -->
            <WrapPanel x:Name="Kpis">
                <Border Style="{StaticResource Kpi}" Tag="fps" ToolTip="Server frames per second and the standard deviation of the frame time (net_graph's &quot;sv&quot;)">
                    <StackPanel>
                        <TextBlock Text="SERVER FPS" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.FpsText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.FpsSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="frame" ToolTip="Time between frames; should stay at the tick interval">
                    <StackPanel>
                        <TextBlock Text="FRAME TIME" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.FrameText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.FrameSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="load" ToolTip="Share of the time the game thread was busy (CPU time of the thread measured by the native module). Near 100 % the server cannot keep its tick rate.">
                    <StackPanel>
                        <TextBlock Text="GAME THREAD LOAD" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.LoadText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.LoadSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="tick">
                    <StackPanel>
                        <TextBlock Text="TICKS / SECOND" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.TickText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.TickSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="cpu" ToolTip="CPU time of the srcds process like the engine's &quot;stats&quot; command (100 % = one core)">
                    <StackPanel>
                        <TextBlock Text="CPU (STATS)" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.CpuText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.CpuSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="memory">
                    <StackPanel>
                        <TextBlock Text="MEMORY" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.MemoryText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.MemorySub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="lua">
                    <StackPanel>
                        <TextBlock Text="LUA MEMORY" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.LuaText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.LuaSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="players">
                    <StackPanel>
                        <TextBlock Text="PLAYERS" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.PlayersText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.PlayersSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="entities" ToolTip="Edicts are limited to 8192; the server crashes when it runs out">
                    <StackPanel>
                        <TextBlock Text="ENTITIES" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.EntitiesText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.EntitiesSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="network">
                    <StackPanel>
                        <TextBlock Text="NETWORK" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.NetText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.NetSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kpi}" Tag="uptime">
                    <StackPanel>
                        <TextBlock Text="UPTIME" Style="{StaticResource KpiLabel}" />
                        <TextBlock Text="{Binding Stats.UptimeText}" Style="{StaticResource KpiValue}" />
                        <TextBlock Text="{Binding Stats.UptimeSub}" Style="{StaticResource KpiSub}" />
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- charts: two to a row (Tag: id for hiding, span in twelfths); addon and plugin charts join them -->
            <WrapPanel x:Name="Charts" SizeChanged="OnChartsSizeChanged">
                <Border Style="{StaticResource ChartCard}" Tag="chart.frame">
                    <c:TimeSeriesChart x:Name="FrameChart" Title="Frame time" Unit="ms" Decimals="1" MinimumMax="20" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.load">
                    <c:TimeSeriesChart x:Name="LoadChart" Title="Load" Unit="%" Decimals="0" MinimumMax="20" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.rate">
                    <c:TimeSeriesChart x:Name="FpsChart" Title="Rate" Unit="/s" Decimals="1" MinimumMax="10" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.memory">
                    <c:TimeSeriesChart x:Name="MemChart" Title="Memory" Unit="MB" Decimals="0" MinimumMax="64" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.network">
                    <c:TimeSeriesChart x:Name="NetChart" Title="Network" Unit="KB/s" Decimals="1" MinimumMax="4" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.players">
                    <c:TimeSeriesChart x:Name="PlayersChart" Title="Players" Decimals="0" MinimumMax="4" />
                </Border>
                <Border Style="{StaticResource ChartCard}" Tag="chart.entities" c:StatsLayout.Span="12">
                    <c:TimeSeriesChart x:Name="EntsChart" Title="Entities" Decimals="0" MinimumMax="100" />
                </Border>
            </WrapPanel>

            <!-- the other widgets of addons and plugins' sections -->
            <WrapPanel x:Name="Extras" Grid.IsSharedSizeScope="True" SizeChanged="OnChartsSizeChanged" />

            <!-- long frames: what each one was made of -->
            <Border x:Name="SpikesCard" Tag="spikes" Style="{StaticResource Card}" Margin="0,0,10,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <ToggleButton x:Name="CaptureButton" Style="{StaticResource Toggle.Ghost}" Click="OnCapture" Margin="0,0,6,0"
                                          ToolTip="Times every hook, timer and net message per frame and turns on the engine profiler (vprof): each long frame then names what ran in it. Costs 1-3 µs per Lua call and a little engine time; switch it off when done.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" FontSize="13" />
                                    <TextBlock x:Name="CaptureLabel" Text="Detailed capture" Margin="7,0,0,0" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource Btn.Ghost}" Click="OnClearSpikes" ToolTip="Clear the list">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="13" />
                                    <TextBlock Text="Clear" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Lag spikes" Style="{StaticResource Text.Title}" />
                            <TextBlock x:Name="SpikesInfo" Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <ItemsControl x:Name="SpikeList" ItemsSource="{Binding Stats.Spikes}" c:ScrollChain.IsEnabled="True" c:LuaLinks.IsEnabled="True" MaxHeight="440">
                            <ItemsControl.Template>
                                <ControlTemplate>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SpikeRow}">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="2,6,2,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,2,0,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding MsText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Danger}" Margin="0,2,0,0" ToolTip="Length of the frame" />
                                            <TextBlock Grid.Column="2" Text="{Binding BusyText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Margin="0,2,0,0" ToolTip="CPU time of the game thread in this frame" />
                                            <!-- why: chips -->
                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Causes}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SpikeCause}">
                                                        <Border CornerRadius="4" Padding="7,2" Margin="0,0,6,4" Background="{Binding Kind, Converter={StaticResource KindToSoftBrush}}"
                                                                ToolTip="{Binding Tooltip}">
                                                            <TextBlock Text="{Binding Text}" Tag="{Binding Source}" FontSize="12" Foreground="{Binding Kind, Converter={StaticResource KindToBrush}}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- detailed capture: the Lua of the frame, the engine's profile -->
                                            <DockPanel Grid.Row="1" Grid.Column="3" Margin="0,2,0,0" Visibility="{Binding HasLua, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Left" Text="Lua" Width="52" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" />
                                                <ItemsControl ItemsSource="{Binding Lua}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SpikePart}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,2" ToolTip="{Binding Tooltip}">
                                                                <TextBlock Text="{Binding Text}" Tag="{Binding Source}" FontSize="12" Foreground="{DynamicResource Brush.Text}" />
                                                                <TextBlock Text="{Binding MsText}" Margin="6,0,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                            <DockPanel Grid.Row="2" Grid.Column="3" Margin="0,2,0,0" Visibility="{Binding HasEngine, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock DockPanel.Dock="Left" Text="Engine" Width="52" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}"
                                                           ToolTip="The engine's own profiler (vprof): the parts of the frame by their own time" />
                                                <ItemsControl ItemsSource="{Binding Engine}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:SpikePart}">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,16,2" ToolTip="{Binding Tooltip}">
                                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                                <TextBlock Text="{Binding MsText}" Margin="6,0,0,0" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoSpikes" Text="No lag spikes so far." Style="{StaticResource Text.Muted}" Margin="0,8" HorizontalAlignment="Center" />
                    </Grid>
                </DockPanel>
            </Border>


            <!-- profiler -->
            <Border x:Name="ProfilerCard" Tag="profiler" Style="{StaticResource Card}" Margin="0,0,10,10">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="ProfButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Click="OnProfile" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ProfIcon" Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource Brush.OnAccent}" />
                                <TextBlock x:Name="ProfLabel" Text="Start profiling" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Lua profiler" Style="{StaticResource Text.Title}" />
                            <TextBlock x:Name="ProfInfo" Style="{StaticResource Text.Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,12,0"
                                       Text="Times every hook, timer and net message handler and counts outgoing net messages and entities. Costs 1-3 µs per call while it runs, so switch it off when done." />
                        </StackPanel>
                    </DockPanel>
                    <Grid x:Name="ProfTables" Margin="0,12,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                            <TextBlock Text="HOOKS (event / name)" Style="{StaticResource Text.Section}" />
                            <DataGrid x:Name="HooksGrid" ItemsSource="{Binding Stats.Hooks}" Style="{StaticResource ProfGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hook" Binding="{Binding Key}" Width="2*" ElementStyle="{StaticResource DefinedInCell}" />
                                    <DataGridTextColumn Header="ms/s" Binding="{Binding MsText}" SortMemberPath="MsPerSec" Width="70" />
                                    <DataGridTextColumn Header="calls/s" Binding="{Binding CallsText}" SortMemberPath="CallsPerSec" Width="70" />
                                    <DataGridTextColumn Header="max ms" Binding="{Binding MaxText}" SortMemberPath="MaxMs" Width="70" />
                                    <DataGridTextColumn Header="Defined in" Binding="{Binding Source}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Text="TIMERS" Style="{StaticResource Text.Section}" />
                            <DataGrid x:Name="TimersGrid" ItemsSource="{Binding Stats.Timers}" Style="{StaticResource ProfGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timer" Binding="{Binding Key}" Width="*" ElementStyle="{StaticResource DefinedInCell}" />
                                    <DataGridTextColumn Header="ms/s" Binding="{Binding MsText}" SortMemberPath="MsPerSec" Width="65" />
                                    <DataGridTextColumn Header="calls/s" Binding="{Binding CallsText}" SortMemberPath="CallsPerSec" Width="65" />
                                    <DataGridTextColumn Header="max ms" Binding="{Binding MaxText}" SortMemberPath="MaxMs" Width="65" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="ENTITIES BY CLASS" Style="{StaticResource Text.Section}" />
                            <DataGrid x:Name="EntsGrid" ItemsSource="{Binding Stats.EntityClasses}" Style="{StaticResource ProfGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="*" />
                                    <DataGridTextColumn Header="Count" Binding="{Binding Count}" SortMemberPath="Count" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="NET MESSAGES RECEIVED" Style="{StaticResource Text.Section}" />
                            <DataGrid x:Name="NetInGrid" ItemsSource="{Binding Stats.NetReceive}" Style="{StaticResource ProfGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Key}" Width="*" ElementStyle="{StaticResource DefinedInCell}" />
                                    <DataGridTextColumn Header="ms/s" Binding="{Binding MsText}" SortMemberPath="MsPerSec" Width="60" />
                                    <DataGridTextColumn Header="msg/s" Binding="{Binding CallsText}" SortMemberPath="CallsPerSec" Width="60" />
                                    <DataGridTextColumn Header="data" Binding="{Binding BytesText}" SortMemberPath="BytesPerSec" Width="85" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="NET MESSAGES SENT" Style="{StaticResource Text.Section}" />
                            <DataGrid x:Name="NetOutGrid" ItemsSource="{Binding Stats.NetSend}" Style="{StaticResource ProfGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Key}" Width="*" />
                                    <DataGridTextColumn Header="msg/s" Binding="{Binding CallsText}" SortMemberPath="CallsPerSec" Width="60" />
                                    <DataGridTextColumn Header="data (all recipients)" Binding="{Binding BytesText}" SortMemberPath="BytesPerSec" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
