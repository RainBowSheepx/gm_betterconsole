<Window x:Class="BetterConsole.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BetterConsole.App.ViewModels"
        xmlns:c="clr-namespace:BetterConsole.App.Controls"
        Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="760" MinHeight="460"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="{DynamicResource Font.Size}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusSep" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="10,7" />
            <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="StatusLabel" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="StatusValue" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================================================== header: tabs + server controls -->
        <Border Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <DockPanel Height="{DynamicResource Size.Header}" LastChildFill="True">
                <Image x:Name="LogoImage" Source="Assets/logo.png" Width="22" Height="22" Margin="14,0,8,0" DockPanel.Dock="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- multi-console: the logo opens the server list (the shown server's name is in the window title) -->
                <Button x:Name="ServerButton" DockPanel.Dock="Left" Style="{StaticResource Btn.Ghost}" Margin="6,0,2,0" Padding="8,4" Height="{DynamicResource Size.HeaderButton}"
                        Click="OnServerButton" Visibility="Collapsed">
                    <Grid>
                        <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Ellipse x:Name="AttentionDot" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0"
                                 Fill="{DynamicResource Brush.Danger}" Stroke="{DynamicResource Brush.Panel}" StrokeThickness="1.5" Visibility="Collapsed" />
                    </Grid>
                </Button>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                    <!-- state pill -->
                    <Border x:Name="StatePill" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StateDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextMuted}" />
                            <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            <Border x:Name="UptimeHost">
                                <TextBlock Text="{Binding UptimeText}" FontFamily="{StaticResource Font.Mono}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}" Visibility="{Binding UptimeText, Converter={StaticResource NullToCollapsed}}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button x:Name="StartButton" Style="{StaticResource Btn.Primary}" Command="{Binding StartCommand}" Margin="0,0,6,0" Padding="12,4" ToolTip="Start the server (F5)"
                            Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Foreground="{DynamicResource Brush.OnAccent}" />
                            <TextBlock x:Name="StartLabel" Text="Start" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding StopCommand}" Margin="0,0,6,0" Padding="12,4" ToolTip="Send quit and wait (Shift+F5)"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71A;" FontSize="12" Foreground="{DynamicResource Brush.Danger}" />
                            <TextBlock x:Name="StopLabel" Text="Stop" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn}" Command="{Binding RestartCommand}" Margin="0,0,6,0" Padding="12,4" ToolTip="Stop and start again (Ctrl+F5)"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
                            <TextBlock x:Name="RestartLabel" Text="Restart" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource Btn.Icon}" Content="&#xE712;" ToolTip="More" Click="OnMore" />
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE793;" ToolTip="Theme and compact mode" Click="OnThemeClick" Visibility="{DynamicResource Visibility.NotCompact}" />
                    <Button Style="{StaticResource Btn.Icon}" Content="&#xE713;" ToolTip="Settings" Click="OnSettings" />
                </StackPanel>

                <!-- shown when the tabs do not fit: a list of all of them -->
                <Button x:Name="TabsMenuButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE70D;" FontSize="11"
                        Margin="2,0,8,0" ToolTip="All tabs" Click="OnTabsMenu" Visibility="Collapsed" />

                <!-- tabs -->
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="OnTabsWheel" MouseRightButtonUp="OnTabsRightClick" x:Name="TabScroller" Background="Transparent">
                    <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TabVm}">
                                <RadioButton x:Name="TabButton" Style="{StaticResource TabHeader}" GroupName="Tabs" IsChecked="{Binding IsSelected, Mode=OneWay}" Click="OnTabClick" Height="{DynamicResource Size.Header}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TabIcon" Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="TabTitle" Text="{Binding Header}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <Border CornerRadius="8" Padding="6,0" Margin="7,0,0,0" MinWidth="18" VerticalAlignment="Center"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceActive}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BadgeKind}" Value="danger">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BadgeKind}" Value="accent">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="danger">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BadgeKind}" Value="accent">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <DataTemplate.Triggers>
                                    <!-- icons only: the title moves into the tooltip -->
                                    <DataTrigger Binding="{Binding DataContext.CompactTabs, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                        <Setter TargetName="TabTitle" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="TabIcon" Property="Margin" Value="0" />
                                        <Setter TargetName="TabIcon" Property="FontSize" Value="15" />
                                        <Setter TargetName="TabButton" Property="ToolTip" Value="{Binding Header}" />
                                        <Setter TargetName="TabButton" Property="Padding" Value="11,0" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===================================================== tab content (views stay alive) -->
        <Grid x:Name="Host" Grid.Row="1" />

        <!-- toasts -->
        <ItemsControl x:Name="ToastList" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,22,78" IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastVm}">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="8"
                            Padding="12,9" Margin="0,8,0,0" MaxWidth="460" HorizontalAlignment="Right">
                        <Border.Effect>
                            <DynamicResource ResourceKey="Effect.Shadow" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{Binding ColorKey, Converter={StaticResource ResourceBrush}}" />
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxWidth="400" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===================================================== status bar -->
        <Border x:Name="StatusBar" Grid.Row="2" MouseRightButtonUp="OnStatusBarRightClick" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <DockPanel Height="{DynamicResource Size.StatusBar}" Margin="12,0">
                <StackPanel x:Name="BridgeItem" Tag="addon" DockPanel.Dock="Right" Orientation="Horizontal" ToolTip="{Binding BridgeTooltip}" Background="Transparent">
                    <Border Style="{StaticResource StatusSep}" />
                    <Ellipse x:Name="BridgeDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding BridgeText}" Style="{StaticResource StatusText}" />
                </StackPanel>

                <!-- In a narrow window the items that do not fit are left out, from the end. -->
                <c:OverflowPanel x:Name="StatusItems">
                    <StackPanel Orientation="Horizontal" ToolTip="Map" Tag="map">
                        <Border Style="{StaticResource StatusSep}" Visibility="Collapsed" />
                        <TextBlock Text="&#xE707;" FontFamily="{StaticResource Font.Icons}" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding MapText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Players / max (+ bots)" Tag="players">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Players" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding PlayersText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding CpuTooltip}" Tag="cpu">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="CPU" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Data received from all clients" Tag="in">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="In" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding InText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Data sent to all clients" Tag="out">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Out" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding OutText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding SvTooltip}" Tag="sv">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="SV" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding SvText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Ticks per second / tick rate" Tag="tick">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Tick" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding TickText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Game thread load: share of time the main thread was busy" Tag="load">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Load" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding LoadText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Entities (edicts)" Tag="ents">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Ents" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding EntsText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Lua memory" Tag="lua">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="Lua" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding LuaText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" ToolTip="Private memory of srcds" Tag="ram">
                        <Border Style="{StaticResource StatusSep}" />
                        <TextBlock Text="RAM" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding MemText}" Style="{StaticResource StatusValue}" />
                    </StackPanel>
                    <!-- items of plugins and addons: as many as fit in what is left -->
                    <ItemsControl x:Name="ExtraStatusList" ItemsSource="{Binding ExtraStatus}" c:OverflowPanel.CanShrink="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:OverflowPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:StatusItemVm}">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding Tooltip}">
                                    <Border x:Name="Sep" Style="{StaticResource StatusSep}" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource StatusLabel}" Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock x:Name="T" Text="{Binding Text}" Style="{StaticResource StatusText}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- with a label it looks like the built-in items: the value in the mono font -->
                                    <DataTrigger Binding="{Binding HasLabel}" Value="True">
                                        <Setter TargetName="T" Property="Style" Value="{StaticResource StatusValue}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Foreground, Converter={StaticResource NullToCollapsed}}" Value="Visible">
                                        <Setter TargetName="T" Property="Foreground" Value="{Binding Foreground}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </c:OverflowPanel>
            </DockPanel>
        </Border>

        <!-- ===================================================== the server list (multi-console): slides in over the window -->
        <Grid x:Name="SideOverlay" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="100">
            <Border x:Name="SideDim" Background="#FF000000" Opacity="0" MouseLeftButtonDown="OnSideDimClick" />
            <Border x:Name="SidePanel" Width="330" HorizontalAlignment="Left" Background="{DynamicResource Brush.Panel}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SideShift" X="-340" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DynamicResource ResourceKey="Effect.ShadowLarge" />
                </Border.Effect>
                <DockPanel>
                    <!-- same height as the header, so the logo stays where it was -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                        <DockPanel Height="{DynamicResource Size.Header}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="11" Margin="0,0,8,0" ToolTip="Close (Esc)" Click="OnSideClose" />
                            <Button Style="{StaticResource Btn.Ghost}" Margin="6,0,6,0" Padding="8,4" Height="{DynamicResource Size.HeaderButton}" Click="OnSideClose" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="Servers" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Brush.Text}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,12">
                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="-10,0,-10,8" />
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSideAddServer" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="13" />
                                <TextBlock Text="Add a server…" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SideMergeButton" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSideMerge" Padding="10,7"
                                ToolTip="Close the servers' own windows and show them all here again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A0;" FontSize="13" />
                                <TextBlock Text="Bring all servers into this window" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSideJournal" Padding="10,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="13" />
                                <TextBlock Text="Start / stop journal" Margin="10,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,4">
                        <ItemsControl x:Name="ServerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ServerViewModel}">
                                    <Border x:Name="Item" CornerRadius="{DynamicResource Radius}" Padding="10,8,6,9" Margin="0,0,0,4" Background="Transparent"
                                            BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                                            MouseLeftButtonUp="OnSideServerClick" MouseRightButtonUp="OnSideServerMenu">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Margin="2,5,10,0" VerticalAlignment="Top"
                                                     Fill="{Binding StateColorKey, Converter={StaticResource ResourceBrush}}" ToolTip="{Binding StateText}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding HostnameIfDifferent}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding HostnameIfDifferent, Converter={StaticResource NullToCollapsed}}" Margin="0,1,0,0" />
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                           FontFamily="{StaticResource Font.Mono}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Border Style="{StaticResource Pill}" Background="{DynamicResource Brush.DangerSoft}" Margin="0,0,4,0" Padding="6,0" VerticalAlignment="Center"
                                                        Visibility="{Binding UnseenErrors, Converter={StaticResource NullToCollapsed}}" ToolTip="Server errors you have not looked at">
                                                    <TextBlock Text="{Binding UnseenErrors}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="2,2,4,0" Foreground="{DynamicResource Brush.TextMuted}"
                                                           ToolTip="In a window of its own" Visibility="{Binding IsDetached, Converter={StaticResource BoolToVisibility}}" />
                                                <Button x:Name="ItemMore" Style="{StaticResource Btn.Icon}" Width="24" Height="22" Content="&#xE712;" FontSize="11" Click="OnSideServerMore"
                                                        ToolTip="Start, stop, own window, settings" Opacity="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="Item" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                            <Setter TargetName="ItemMore" Property="Opacity" Value="1" />
                                        </Trigger>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource SameObject}">
                                                    <Binding />
                                                    <Binding Path="CurrentServer" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Surface}" />
                                            <Setter TargetName="Item" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
